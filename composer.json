{
    "name": "marks-software-gmbh/yab-cms-ff",
    "description": "Yet Another Boring CMS – Fast Forward (YAB CMS). A CakePHP 5 + PHP 8 powered Bootstrap CMS with AdminLTE.",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/MarksSoftwareGmbH/YAB-CMS-FF",
    "authors": [
        {
            "name": "Marks Software GmbH - Lukas Marks",
            "email": "info@marks-software.de",
            "homepage": "https://www.marks-software.de",
            "role": "Developer"
        }
    ],
    "keywords": ["cms", "cakephp", "cakephp5", "bootstrap", "adminlte", "php8", "content-management", "sqlite", "eav", "rest", "api"],
    "prefer-stable": true,
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-ftp": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-simplexml": "*",
        "ext-soap": "*",
        "ext-zip": "*",
        "almasaeed2010/adminlte": "^3.2",
        "cakephp/authentication": "^4.2",
        "cakephp/authorization": "^3.0",
        "cakephp/cakephp": "5.4.*",
        "cakephp/migrations": "^5.0",
        "cakephp/plugin-installer": "^2.0",
        "dereuromark/cakephp-tinyauth": "^4.1",
        "firebase/php-jwt": "^7.2",
        "friendsofcake/bootstrap-ui": "^5.2",
        "friendsofcake/cakephp-csvview": "^5.1",
        "friendsofcake/crud": "^7.2",
        "friendsofcake/search": "^7.9",
        "intervention/image": "^4.4",
        "mobiledetect/mobiledetectlib": "^4.11",
        "phpoffice/phpspreadsheet": "^2.4.8",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "cakephp/bake": "^3.6",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2",
        "josegonzalez/dotenv": "^4.0",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0"
    },
    "suggest": {
        "cakephp/repl": "Console tools for a REPL interface for CakePHP applications.",
        "dereuromark/cakephp-ide-helper": "After baking your code, this keeps your annotations in sync with the code evolving from there on for maximum IDE and PHPStan/Psalm compatibility.",
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification.",
        "phpstan/phpstan": "PHPStan focuses on finding errors in your code without actually running it. It catches whole classes of bugs even before you write tests for the code."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "App\\Console\\Installer::postInstall",
            "@link-adminlte"
        ],
        "post-update-cmd": [
            "@link-adminlte"
        ],
        "post-create-project-cmd": [
            "App\\Console\\Installer::postInstall",
            "@link-adminlte"
        ],
        "link-adminlte": [
            "ln -sfn ../../../vendor/almasaeed2010/adminlte plugins/YabCmsFf/webroot/adminlte"
        ],
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "test": "phpunit --colors=always"
    }
}
